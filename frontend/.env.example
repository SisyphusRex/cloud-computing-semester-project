# Copy to .env.local (git-ignored by Vite's convention) and adjust.

# 1 = sign in by typing an email; the APIs must run with LI_DEV_AUTH=1 (`make dev-up`).
VITE_DEV_AUTH=1

# OAuth web client ID (docs/runbooks/bootstrap.md step 5). Needed when VITE_DEV_AUTH is off.
VITE_GOOGLE_CLIENT_ID=

# Empty locally (the dev server proxies /ingest and /search).
# In production: https://<api_hostname from terraform output>
VITE_API_BASE=
