# Production values, from `terraform output` in infra/terraform/envs/prod
# (plus the OAuth client ID and professor list). PROJECT_ID etc. are
# placeholders until the infrastructure is applied. None of this is secret.
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
PROFESSOR_EMAILS=REPLACE_ME@example.edu
# output frontend_url (the Cloud Run frontend)
CORS_ORIGINS=https://REPLACE_ME.run.app
# output cloudsql.connection_name
CLOUDSQL_CONNECTION_NAME=PROJECT_ID:us-central1:li-pg
# IAM database users: the service account email without .gserviceaccount.com
INGEST_DB_USER=li-ingest@PROJECT_ID.iam
SEARCH_DB_USER=li-search@PROJECT_ID.iam
# output migrate_grants
MIGRATE_GRANTS=li_ingest_role=li-ingest@PROJECT_ID.iam,li_search_role=li-search@PROJECT_ID.iam
# output workload_service_accounts
INGEST_GSA=li-ingest@PROJECT_ID.iam.gserviceaccount.com
SEARCH_GSA=li-search@PROJECT_ID.iam.gserviceaccount.com
MIGRATE_GSA=li-migrate@PROJECT_ID.iam.gserviceaccount.com
# output api_hostname
API_HOSTNAME=0-0-0-0.sslip.io
# output cloudsql.admin_password_secret + /versions/latest
DB_ADMIN_SECRET_VERSION=projects/PROJECT_ID/secrets/db-admin-password/versions/latest
