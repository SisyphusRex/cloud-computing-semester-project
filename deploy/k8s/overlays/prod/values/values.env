# Production values, from `terraform output` in infra/terraform/envs/prod
# (plus the OAuth client ID). None of this is secret.
GOOGLE_CLIENT_ID=294292796743-npo1ene9euu5v10tundn5inb1sval8n4.apps.googleusercontent.com
# Unused since ADR 0002 (roles live in the database). Kept, empty, for one release
# so a rollback to the previous pods still finds the key; then delete it.
PROFESSOR_EMAILS=
# output frontend_url (the Cloud Run frontend)
CORS_ORIGINS=https://li-frontend-byshtpdfha-uc.a.run.app
# output cloudsql.connection_name
CLOUDSQL_CONNECTION_NAME=lecture-indexer-511419:us-central1:li-pg
# IAM database users: the service account email without .gserviceaccount.com
INGEST_DB_USER=li-ingest@lecture-indexer-511419.iam
SEARCH_DB_USER=li-search@lecture-indexer-511419.iam
# output migrate_grants
MIGRATE_GRANTS=li_ingest_role=li-ingest@lecture-indexer-511419.iam,li_search_role=li-search@lecture-indexer-511419.iam
# output workload_service_accounts
INGEST_GSA=li-ingest@lecture-indexer-511419.iam.gserviceaccount.com
SEARCH_GSA=li-search@lecture-indexer-511419.iam.gserviceaccount.com
BACKUP_GSA=li-backup@lecture-indexer-511419.iam.gserviceaccount.com
MIGRATE_GSA=li-migrate@lecture-indexer-511419.iam.gserviceaccount.com
# output api_hostname
API_HOSTNAME=34-128-137-19.sslip.io
# output cloudsql.admin_password_secret + /versions/latest
DB_ADMIN_SECRET_VERSION=projects/lecture-indexer-511419/secrets/db-admin-password/versions/latest
# output backup_sas_secret + /versions/latest
BACKUP_SAS_SECRET_VERSION=projects/lecture-indexer-511419/secrets/backup-sas/versions/latest
# Public key from age-keygen; the private key stays offline (ADR 0004)
BACKUP_AGE_RECIPIENT=age1zuvsq4vtwc49dwkdt8uknl3kh2z2rt52p8r3kmfag4n9a0kwz4sqes3nz2
# bootstrap output backup_container_url
BACKUP_CONTAINER_URL=https://libackupecd087147d.blob.core.windows.net/backups
