# For running the services outside docker-compose (e.g. `uv run flask --app ingest run`).
# Copy to .env and adjust; .env is git-ignored.
DATABASE_URL=postgresql://li:li@localhost:55432/li
LI_DEV_AUTH=1
CORS_ORIGINS=http://localhost:5173
# Required once LI_DEV_AUTH is off: the OAuth web client ID from the GCP console.
GOOGLE_CLIENT_ID=
