{
  "uid": "lecture-indexer",
  "title": "Lecture Indexer",
  "description": "Google Cloud services and Azure backup storage, on one page.",
  "tags": [
    "lecture-indexer"
  ],
  "timezone": "browser",
  "refresh": "5m",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Flat or empty charts are expected while the environment is paused (`make cloud-pause`). Azure storage charts report hourly, so they can lag a backup by about an hour."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "panels": []
    },
    {
      "id": 3,
      "title": "Database up",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "stackdriver",
        "uid": "li-gcp"
      },
      "targets": [
        {
          "queryType": "timeSeriesList",
          "datasource": {
            "type": "stackdriver",
            "uid": "li-gcp"
          },
          "timeSeriesList": {
            "projectName": "lecture-indexer-511419",
            "filters": [
              "metric.type",
              "=",
              "cloudsql.googleapis.com/database/up"
            ],
            "perSeriesAligner": "ALIGN_MEAN",
            "crossSeriesReducer": "REDUCE_MIN",
            "groupBys": [],
            "alignmentPeriod": "cloud-monitoring-auto",
            "view": "FULL",
            "preprocessor": "none"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "type": "stat",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
